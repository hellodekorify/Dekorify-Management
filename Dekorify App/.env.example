# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses SQLite so the app runs with zero database setup.
# To move to PostgreSQL, change the `provider` in prisma/schema.prisma to
# "postgresql" and set DATABASE_URL to your connection string, e.g.
#   DATABASE_URL="postgresql://user:password@localhost:5432/dekorify"
# No application code needs to change: all money is stored as integer minor
# units (BigInt), which behaves identically on both engines.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign session cookies. Generate a new one for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters-long"

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Where uploaded receipts and original import files are kept on disk.
STORAGE_DIR="./storage"

# ---------------------------------------------------------------------------
# Shopify integration (optional - leave blank until you connect a store)
# ---------------------------------------------------------------------------
# Create a custom/public app at https://partners.shopify.com and paste the
# credentials here. Never commit real values.
#
# Add this redirect URL to the app:  {SHOPIFY_APP_URL}/api/shopify/callback
# Webhooks are registered automatically to: {SHOPIFY_APP_URL}/api/shopify/webhooks
# (Shopify must be able to reach that URL, so on localhost you need a tunnel.)
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# read_all_orders is what lifts Shopify's default 60-day order window; without
# it older orders are silently omitted rather than refused.
# read_locations lets inventory levels report which location they belong to.
SHOPIFY_SCOPES="read_orders,read_all_orders,read_products,read_customers,read_inventory,read_locations"
SHOPIFY_APP_URL="http://localhost:3000"
# Shopify ships a new version each quarter and supports each for ~12 months.
# 2026-07 is current; bump this when you migrate.
SHOPIFY_API_VERSION="2026-07"

# ---------------------------------------------------------------------------
# Leopards Courier (optional - can also be set per store in Settings > Couriers)
# ---------------------------------------------------------------------------
# Supplied by your Leopards account manager. When set here, these always take
# precedence over anything saved in the database.
LEOPARDS_API_KEY=""
LEOPARDS_API_PASSWORD=""
# "production" -> https://merchantapi.leopardscourier.com
# "staging"    -> https://merchantapistaging.leopardscourier.com (often down;
#                 prefer "production" unless Leopards tell you otherwise)
LEOPARDS_API_ENVIRONMENT="production"

# Shown to Leopards as the shipper on every booking.
STORE_CONTACT_EMAIL=""
STORE_CONTACT_PHONE=""

# ---------------------------------------------------------------------------
# Scheduled synchronisation
# ---------------------------------------------------------------------------
# Shared secret for the scheduled endpoints. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   POST /api/tracking/sync   Leopards shipment tracking only. Touches no other
#                             service, so it keeps working with Shopify off.
#   POST /api/cron/sync       The older combined job (Shopify orders + legacy
#                             order tracking).
#
# Leopards publishes no webhooks, so tracking stays current by polling. Point a
# scheduler at /api/tracking/sync every 10-15 minutes; the engine decides which
# parcels are actually due from the interval set in Settings -> Tracking, so
# calling it more often than that costs nothing extra at Leopards.
#
#   curl -X POST http://localhost:3000/api/tracking/sync \
#        -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""
